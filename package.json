{
  "name": "my-better-t-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check-types": "npm run check-types --workspaces --if-present",
    "dev:web": "npm run dev --workspace web"
  },
  "dependencies": {
    "@my-better-t-app/env": "*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@my-better-t-app/config": "*",
    "@types/node": "^22.13.14",
    "typescript": "^6"
  },
  "packageManager": "npm@11.17.0"
}
